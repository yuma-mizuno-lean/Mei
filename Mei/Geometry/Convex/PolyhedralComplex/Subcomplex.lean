module

public import TauCeti.Geometry.Convex.PolyhedralComplex.Subcomplex
public import Mei.Geometry.Convex.PolyhedralComplex.Strata

/-! # Subcomplexes generated by cells

A subcomplex retains some of the actual cells of a finite polyhedral complex,
including all their nonempty faces. The subcomplex generated by a chosen family
consists of the ambient cells contained in a chosen cell. Its support is exactly
the union of the chosen ambient cells, and it is the smallest complex retaining
them. This allows one to discard cells while retaining prescribed wall supports.
Generation commutes with integral affine transport. Unbounded cells and lineality
are allowed throughout.
-/

public section

namespace TauCeti.FinitePolyhedralComplex

variable {N V : Type*} [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V]
  {i : N →+ V} {h : TauCeti.Toric.IsIntegralLattice i}

/-- Every wall of a subcomplex is an ambient wall with the same carrier. -/
theorem IsSubcomplex.walls_subset {C D : FinitePolyhedralComplex h}
    (hDC : D.IsSubcomplex C) : D.walls ⊆ C.walls := by
  intro P hP
  obtain ⟨hPD, hd⟩ := mem_cellsOfCodimension.mp hP
  exact mem_cellsOfCodimension.mpr ⟨isSubcomplex_iff.mp hDC hPD, hd⟩
end TauCeti.FinitePolyhedralComplex
