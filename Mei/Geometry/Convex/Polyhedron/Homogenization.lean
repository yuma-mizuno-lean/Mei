/-!
# Carrier-defined homogenization

The homogenization of `P` is the topological closure of the pointed cone hull
of its height-one embedding. Its definition depends only on the carrier `P`.
The empty carrier gives the zero cone, while positive-height slices recover a
closed convex base after rescaling. Closure is essential for the height-zero
directions of an unbounded base.
-/

public section

open Set Filter
open scoped Topology

namespace Mei.Convex

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- The closed pointed cone generated by the height-one embedding of a set. -/
@[expose] def homogenization (P : Set V) : PointedCone ℝ (V × ℝ) :=
  (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)).topologicalClosure

/-- Membership in homogenization is membership in the closure of the actual cone hull. -/
theorem mem_homogenization_iff {P : Set V} {z : V × ℝ} :
    z ∈ homogenization P ↔
      z ∈ closure (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) : Set (V × ℝ)) :=
  Iff.rfl

/-- Homogenization is a closed cone. -/
theorem isClosed_homogenization (P : Set V) : IsClosed (homogenization P : Set (V × ℝ)) :=
  Submodule.isClosed_topologicalClosure _

/-- The height-one embedding lies in the homogenization. -/
theorem mem_homogenization_one {P : Set V} {p : V} (hp : p ∈ P) :
    (p, (1 : ℝ)) ∈ homogenization P :=
  Submodule.le_topologicalClosure _ (PointedCone.subset_hull ⟨p, hp, rfl⟩)

/-- Homogenization preserves inclusions of carriers. -/
theorem homogenization_mono {P Q : Set V} (h : P ⊆ Q) :
    homogenization P ≤ homogenization Q :=
  Submodule.topologicalClosure_mono (Submodule.span_mono (Set.image_mono h))

/-- The empty base gives exactly the zero cone. -/
@[simp]
theorem homogenization_empty : homogenization (∅ : Set V) = ⊥ := by
  apply SetLike.ext'
  simp [homogenization, Submodule.topologicalClosure_coe]

/-- A cone-hull point over a convex base is zero or one positive multiple of a
height-one base point. No closure is taken in this statement. -/
theorem _root_.Convex.mem_hull_heightOne_iff {P : Set V}
    (hP : _root_.Convex ℝ P) {z : V × ℝ} :
    z ∈ PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) ↔
      z = 0 ∨ ∃ t : ℝ, 0 < t ∧ ∃ p ∈ P, z = (t • p, t) := by
  constructor
  · intro hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨p, hp, rfl⟩ := hz
      exact Or.inr ⟨1, zero_lt_one, p, hp, by simp⟩
    | zero => exact Or.inl rfl
    | add z w hz hw iz iw =>
      rcases iz with rfl | ⟨t, ht, p, hp, rfl⟩
      · simpa using iw
      rcases iw with rfl | ⟨s, hs, q, hq, rfl⟩
      · exact Or.inr ⟨t, ht, p, hp, by simp⟩
      obtain ⟨r, hr, he⟩ := hP.exists_mem_add_smul_eq hp hq ht.le hs.le
      exact Or.inr ⟨t + s, add_pos ht hs, r, hr, Prod.ext he.symm rfl⟩
    | smul c z hz iz =>
      rcases iz with rfl | ⟨t, ht, p, hp, rfl⟩
      · exact Or.inl (smul_zero _)
      rcases eq_or_lt_of_le c.property with hc | hc
      · left
        change ((c : ℝ) • (t • p), (c : ℝ) * t) = 0
        simp [← hc]
      · right
        refine ⟨c.val * t, mul_pos hc ht, p, hp, ?_⟩
        change ((c : ℝ) • (t • p), (c : ℝ) * t) = _
        rw [smul_smul]
  · rintro (rfl | ⟨t, ht, p, hp, rfl⟩)
    · exact Submodule.zero_mem _
    · have hm := PointedCone.smul_mem
        (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)) ht.le
        (PointedCone.subset_hull (Set.mem_image_of_mem _ hp))
      simpa using hm

/-- Homogenization has no points of negative height. -/
theorem homogenization_height_nonneg {P : Set V} {z : V × ℝ}
    (hz : z ∈ homogenization P) : 0 ≤ z.2 := by
  apply closure_minimal (s :=
      (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) : Set (V × ℝ)))
    (t := {z : V × ℝ | 0 ≤ z.2}) ?_
    (isClosed_le continuous_const continuous_snd) hz
  intro w hw
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨p, hp, rfl⟩ := hw
    exact zero_le_one
  | zero => exact (show (0 : ℝ) ≤ 0 from le_rfl)
  | add w z hw hz iw iz =>
    change 0 ≤ w.2 + z.2
    exact add_nonneg iw iz
  | smul c w hw iw =>
    change 0 ≤ (c : ℝ) * w.2
    exact mul_nonneg c.property iw

/-- Positive-height slices recover a closed convex base after rescaling. -/
theorem _root_.Convex.mem_homogenization_pos_iff {P : Set V} (hconvex : _root_.Convex ℝ P)
    (hclosed : IsClosed P) {x : V} {t : ℝ} (ht : 0 < t) :
    (x, t) ∈ homogenization P ↔ t⁻¹ • x ∈ P := by
  constructor
  · intro hz
    obtain ⟨u, hu, hlim⟩ := mem_closure_iff_seq_limit.mp hz
    have hsnd : Tendsto (fun k => (u k).2) atTop (𝓝 t) :=
      (continuous_snd.tendsto (x, t)).comp hlim
    have hfst : Tendsto (fun k => (u k).1) atTop (𝓝 x) :=
      (continuous_fst.tendsto (x, t)).comp hlim
    have hpos : ∀ᶠ k in atTop, 0 < (u k).2 :=
      hsnd.eventually (lt_mem_nhds ht)
    apply hclosed.mem_of_tendsto ((hsnd.inv₀ ht.ne').smul hfst)
    filter_upwards [hpos] with k hk
    rcases (hconvex.mem_hull_heightOne_iff).mp (hu k) with he | ⟨s, hs, p, hp, he⟩
    · simp [he] at hk
    · simp only [he, inv_smul_smul₀ hs.ne']
      exact hp
  · intro hx
    have hm := PointedCone.smul_mem (homogenization P) ht.le (mem_homogenization_one hx)
    convert hm using 1; simp [ht.ne']

/-- The height-one slice of a closed convex base is precisely the original carrier. -/
@[simp]
theorem _root_.Convex.mem_homogenization_one_iff {P : Set V} (hconvex : _root_.Convex ℝ P)
    (hclosed : IsClosed P) {x : V} :
    (x, (1 : ℝ)) ∈ homogenization P ↔ x ∈ P := by
  simpa using hconvex.mem_homogenization_pos_iff hclosed (x := x) zero_lt_one

/-- Every recession direction of a nonempty base occurs at height zero in its
closed homogenization. The approximants are `(v + ε • p, ε)` for `ε > 0`. -/
theorem mem_homogenization_zero_of_mem_recessionCone {P : Set V} (hne : P.Nonempty)
    {v : V} (hv : v ∈ recessionCone P) : (v, (0 : ℝ)) ∈ homogenization P := by
  obtain ⟨p, hp⟩ := hne
  change (v, (0 : ℝ)) ∈ closure
    (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P) : Set (V × ℝ))
  have hlim : Tendsto (fun ε : ℝ => (v + ε • p, ε)) (𝓝[>] 0) (𝓝 (v, (0 : ℝ))) := by
    have hf : Continuous (fun ε : ℝ => (v + ε • p, ε)) :=
      (continuous_const.add (continuous_id.smul continuous_const)).prodMk continuous_id
    have hh : Tendsto (fun ε : ℝ => (v + ε • p, ε)) (𝓝[>] (0 : ℝ))
        (𝓝 (v + (0 : ℝ) • p, (0 : ℝ))) :=
      (hf.tendsto 0).mono_left nhdsWithin_le_nhds
    simpa only [zero_smul, add_zero] using hh
  apply mem_closure_of_tendsto hlim
  filter_upwards [self_mem_nhdsWithin] with ε hε
  have hpos : 0 < ε := hε
  have hpv : p + ε⁻¹ • v ∈ P := hv p hp ε⁻¹ (inv_nonneg.mpr hpos.le)
  have hm := PointedCone.smul_mem
    (PointedCone.hull ℝ ((fun p : V => (p, (1 : ℝ))) '' P)) hpos.le
    (PointedCone.subset_hull (Set.mem_image_of_mem _ hpv))
  have he : (v + ε • p, ε) = ε • (p + ε⁻¹ • v, (1 : ℝ)) := by
    ext
    · change v + ε • p = ε • (p + ε⁻¹ • v)
      rw [smul_add, smul_inv_smul₀ hpos.ne']
      exact add_comm _ _
    · simp
  rw [he]
  exact hm

/-- Height-zero membership implies preservation of all nonnegative base rays. -/
theorem _root_.Convex.mem_recessionCone_of_mem_homogenization_zero {P : Set V}
    (hconvex : _root_.Convex ℝ P) (hclosed : IsClosed P) {v : V}
    (hv : (v, (0 : ℝ)) ∈ homogenization P) :
    v ∈ recessionCone P := by
  intro p hp t ht
  apply (hconvex.mem_homogenization_one_iff hclosed).mp
  have hm := (homogenization P).add_mem (mem_homogenization_one hp)
    (PointedCone.smul_mem (homogenization P) ht hv)
  simpa using hm

/-- For a nonempty closed convex base, its recession cone is precisely the
height-zero slice of its carrier-defined homogenization. -/
theorem _root_.Convex.mem_homogenization_zero_iff {P : Set V} (hconvex : _root_.Convex ℝ P)
    (hne : P.Nonempty) (hclosed : IsClosed P) {v : V} :
    (v, (0 : ℝ)) ∈ homogenization P ↔ v ∈ recessionCone P :=
  ⟨hconvex.mem_recessionCone_of_mem_homogenization_zero hclosed,
    mem_homogenization_zero_of_mem_recessionCone hne⟩

end Mei.Convex
