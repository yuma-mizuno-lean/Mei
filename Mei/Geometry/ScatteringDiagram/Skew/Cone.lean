public import Mei.Geometry.ScatteringDiagram.Skew.Principal
public import Mei.Geometry.Toric.Algebraic.Cone.Basis
public import TauCeti.Geometry.Convex.Cone.Face.Simplicial
public import TauCeti.Geometry.Toric.Algebraic.Cone.Basic

/-!
# The principal positive cone

Given an integral basis of the unfrozen lattice, the cone generated by its principal
lifts has exactly the principal positive monoid as its lattice points. It is rational
and salient, and every supported primitive ray generator belongs to the monoid.
The integral degree is the sum of the unfrozen coordinates, so finite cutoffs follow
from `Module.Basis.positiveDegrees` and the existing graph construction.

These are the cone and degree data of the principal realization in
Gross–Hacking–Keel–Kontsevich, *Canonical bases for cluster algebras*, §1 and
Appendix B, arXiv:1411.1394v2. Only a basis of the unfrozen lattice is needed here;
no nondegeneracy of the skew form or diagonal basis of the other sublattice is required.
-/

public section

noncomputable section

namespace Mei.SkewLatticeDatum

open TauCeti.Toric

variable {N ι V W : Type*} [AddCommGroup N]
  [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  (D : SkewLatticeDatum N) (b : Module.Basis ι ℤ D.unfrozen)
  (j : Module.Dual ℤ D.sublattice →+ W) (i : D.unfrozen →+ V)

/-- The cone spanned by the principal lifts of the unfrozen basis vectors. -/
def principalCone : PointedCone ℝ (W × V) :=
  PointedCone.hull ℝ (Set.range fun a => (j (D.principalCharacter (b a)), i (b a)))

/-- The principal cone is generated by the images of the lifted basis. -/
theorem principalCone_eq_hull :
    D.principalCone b j i = PointedCone.hull ℝ
      ((j.prodMap i) '' Set.range (fun a => D.principalEmbedding (b a))) := by
  simp only [principalCone, ← Set.range_comp, Function.comp_def, principalEmbedding_apply,
    AddMonoidHom.coe_prodMap, Prod.map_apply]

/-- The principal cone is salient: the unfrozen coordinate retains an independent
basis, regardless of the first lattice map or the skew form. -/
theorem salient_principalCone (hi : IsIntegralLattice i) :
    (D.principalCone b j i : ConvexCone ℝ (W × V)).Salient := by
  rw [principalCone]
  exact PointedCone.salient_hull_range
    (LinearIndependent.of_comp (LinearMap.snd ℝ W V) (hi.linearIndependent_basis b))

/-- The principal positive cone is lattice rational, including for the zero skew form. -/
theorem isLatticeRational_principalCone [Finite ι] :
    IsLatticeRational (j.prodMap i) (D.principalCone b j i) := by
  classical
  let := Fintype.ofFinite ι
  refine isLatticeRational_iff.mpr
    ⟨Finset.univ.image (fun a => D.principalEmbedding (b a)), ?_⟩
  simpa only [Finset.coe_image, Finset.coe_univ, Set.image_univ] using
    D.principalCone_eq_hull b j i

variable [Fintype ι]

/-- Principal positive degrees are exactly the lattice points of the principal cone.
The first lattice map only needs to be injective; the unfrozen lattice is integral. -/
theorem principalPositiveDegrees_monoid_eq_latticePoints_principalCone
    (hj : Function.Injective j) (hi : IsIntegralLattice i) :
    (D.principalPositiveDegrees b.positiveDegrees).monoid =
      (D.principalCone b j i).latticePoints (j.prodMap i) :=
  b.positiveDegrees_graph_monoid_eq_latticePoints_hull hi j hj
    D.principalCharacter.toAddMonoidHom

/-- Supported primitive generators belong to the principal positive monoid.
This integral membership does not require real embeddings. -/
theorem supportedRay_generator_mem_principalPositiveDegrees
    (w : SupportedRay (D.principalPositiveDegrees b.positiveDegrees)) :
    w.generator ∈ (D.principalPositiveDegrees b.positiveDegrees).monoid := by
  obtain ⟨a, ha, haw⟩ := w.supported
  have h := (PositiveDegrees.mem_graph_monoid b.positiveDegrees
    D.principalCharacter.toAddMonoidHom _ _).mp haw
  apply (PositiveDegrees.mem_graph_monoid b.positiveDegrees
    D.principalCharacter.toAddMonoidHom _ _).mpr
  constructor
  · apply (b.mem_positiveDegrees_monoid _).mpr
    intro c
    have hc := (b.mem_positiveDegrees_monoid _).mp h.1 c
    simp only [zsmul_eq_smul, map_zsmul, Finsupp.smul_apply, smul_eq_mul] at hc
    exact nonneg_of_mul_nonneg_right hc ha
  · apply LinearMap.ext
    intro n
    have he := congrArg (fun χ => χ n) h.2
    simp only [zsmul_eq_smul, map_zsmul, LinearMap.smul_apply, zsmul_eq_mul] at he
    exact mul_left_cancel₀ ha.ne' he

end Mei.SkewLatticeDatum
