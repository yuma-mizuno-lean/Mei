module

public import Mei.Algebra.PositiveDegrees.Basis
public import Mei.Algebra.PositiveDegrees.Graph
public import Mei.Geometry.Convex.Cone.LatticePoints
public import TauCeti.Geometry.Toric.Algebraic.Lattice

/-!
# Lattice points of cones generated by graph basis vectors

The cone generated by `(f(b j), b j)` has exactly the nonnegative integral
combinations of these vectors as lattice points. The retained second coordinate
prevents additional lattice points even when `f` has a kernel or nonprimitive
values. This identifies graph positive degrees with a saturated cone monoid.

The proof uses Mathlib's scalar-extended basis and its coordinate formula,
`Mei.PositiveDegrees.graph` for the integral monoid, and
`PointedCone.latticePoints_map_prod_id` for the graph lift. Only the second lattice
must span its real vector space; the first lattice map need only be injective.
-/

public section

noncomputable section

namespace Module.Basis

open TauCeti.Toric

variable {ι N M V W : Type*} [Fintype ι] [AddCommGroup N] [AddCommGroup M]
  [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  (b : Basis ι ℤ N) {i : N →+ V} (hi : IsIntegralLattice i)

include hi in
/-- The nonnegative basis monoid is precisely the lattice points of the cone
generated by the images of the integral basis vectors. -/
theorem positiveDegrees_monoid_eq_latticePoints_hull :
    b.positiveDegrees.monoid =
      (PointedCone.hull ℝ (Set.range fun a => i (b a))).latticePoints i := by
  classical
  let B := hi.isBaseChange.basis b
  have hB (n : N) (a : ι) : B.repr (i n) a = (b.repr n a : ℝ) :=
    hi.isBaseChange.basis_repr_comp_apply b n a
  let C := PointedCone.hull ℝ (Set.range fun a => i (b a))
  have hC : ∀ x ∈ C, ∀ a, 0 ≤ B.repr x a := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      intro c
      simp [hB, Finsupp.single_apply, ite_nonneg]
    | zero => simp
    | add x y _ _ hx hy =>
      intro a
      simpa using add_nonneg (hx a) (hy a)
    | smul r x _ hx =>
      intro a
      simpa [← Nonneg.coe_smul] using mul_nonneg r.property (hx a)
  ext n
  rw [b.mem_positiveDegrees_monoid, PointedCone.mem_latticePoints]
  constructor
  · intro hn
    have hsum : (∑ a, (b.repr n a : ℝ) • i (b a)) = i n := by
      simpa only [map_sum, map_zsmul, Int.cast_smul_eq_zsmul] using
        congrArg i (b.sum_repr n)
    rw [← hsum]
    exact C.sum_mem fun a _ => PointedCone.smul_mem C
      (by exact_mod_cast hn a)
      (PointedCone.subset_hull (Set.mem_range_self a))
  · intro hx a
    have ha := hC _ hx a
    rw [hB] at ha
    exact_mod_cast ha

variable (j : M →+ W) (hj : Function.Injective j) (f : N →+ M)

include hi hj in
/-- The nonnegative graph monoid is precisely the lattice points of the cone
generated by the graph of an integral basis. The map `f` need not be injective. -/
theorem positiveDegrees_graph_monoid_eq_latticePoints_hull :
    (b.positiveDegrees.graph f).monoid =
      (PointedCone.hull ℝ (Set.range fun a => (j (f (b a)), i (b a)))).latticePoints
        (j.prodMap i) := by
  have hmap :
      (PointedCone.hull ℝ (Set.range fun a => i (b a))).map
          ((hi.extend j f).prod LinearMap.id) =
        PointedCone.hull ℝ (Set.range fun a => (j (f (b a)), i (b a))) := by
    simp [PointedCone.map, Submodule.map_span, ← Set.range_comp, Function.comp_def]
  rw [← hmap, PointedCone.latticePoints_map_prod_id _ i j f (hi.extend j f)
    (hi.extend_apply j f) hj, ← b.positiveDegrees_monoid_eq_latticePoints_hull hi]
  ext ⟨m, n⟩
  simp [Mei.PositiveDegrees.mem_graph_monoid, AddSubmonoid.mem_map, eq_comm]

end Module.Basis
