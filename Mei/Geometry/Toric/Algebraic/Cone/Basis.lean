module

public import Mei.Algebra.PositiveDegrees.Basis
public import Mei.Algebra.PositiveDegrees.Graph
public import Mei.Geometry.Convex.Cone.LatticePoints
public import TauCeti.Geometry.Toric.Algebraic.Lattice

/-!
# Lattice points of cones generated by graph basis vectors

The cone generated by `(f(b j), b j)` has exactly the nonnegative integral
combinations of these vectors as lattice points. The retained second coordinate
prevents additional lattice points even when `f` has a kernel or nonprimitive
values. This identifies graph positive degrees with a saturated cone monoid.

The proof uses Mathlib's scalar-extended basis and its coordinate formula, and
`Mei.PositiveDegrees.graph` for the integral monoid. Only the second lattice
must span its real vector space; the first lattice map need only be injective.
-/

public section

noncomputable section

namespace Module.Basis

open TauCeti.Toric

variable {ι N M V W : Type*} [Fintype ι] [AddCommGroup N] [AddCommGroup M]
  [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  (b : Basis ι ℤ N) {i : N →+ V} (hi : IsIntegralLattice i)
  (j : M →+ W) (hj : Function.Injective j) (f : N →+ M)

include hi hj in
/-- The nonnegative graph monoid is precisely the lattice points of the cone
generated by the graph of an integral basis. The map `f` need not be injective. -/
theorem positiveDegrees_graph_monoid_eq_latticePoints_hull :
    (b.positiveDegrees.graph f).monoid =
      (PointedCone.hull ℝ (Set.range fun a => (j (f (b a)), i (b a)))).latticePoints
        (j.prodMap i) := by
  classical
  let B := hi.isBaseChange.basis b
  have hB (n : N) (a : ι) : B.repr (i n) a = (b.repr n a : ℝ) :=
    hi.isBaseChange.basis_repr_comp_apply b n a
  let F := hi.extend j f
  let C := PointedCone.hull ℝ (Set.range fun a => (j (f (b a)), i (b a)))
  have hC : ∀ x ∈ C, x.1 = F x.2 ∧ ∀ a, 0 ≤ B.repr x.2 a := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      refine ⟨(hi.extend_apply j f (b a)).symm, fun c => ?_⟩
      simp [hB, Finsupp.single_apply, ite_nonneg]
    | zero => simp
    | add x y _ _ hx hy =>
      exact ⟨by simp [hx.1, hy.1], fun a => by
        simpa using add_nonneg (hx.2 a) (hy.2 a)⟩
    | smul r x _ hx =>
      refine ⟨by simpa using congrArg (r • ·) hx.1, fun a => ?_⟩
      simpa [← Nonneg.coe_smul] using mul_nonneg r.property (hx.2 a)
  ext ⟨m, n⟩
  rw [Mei.PositiveDegrees.mem_graph_monoid, PointedCone.mem_latticePoints]
  constructor
  · rintro ⟨hn, rfl⟩
    have hsum : (∑ a, (b.repr n a : ℝ) • (j (f (b a)), i (b a))) = (j (f n), i n) := by
      simpa only [map_sum, map_zsmul, AddMonoidHom.prod_apply,
        AddMonoidHom.comp_apply, Int.cast_smul_eq_zsmul] using
        congrArg ((j.comp f).prod i) (b.sum_repr n)
    rw [AddMonoidHom.coe_prodMap, Prod.map_apply, ← hsum]
    exact C.sum_mem fun a _ => PointedCone.smul_mem C
      (by exact_mod_cast (b.mem_positiveDegrees_monoid n).mp hn a)
      (PointedCone.subset_hull (Set.mem_range_self a))
  · intro hx
    obtain ⟨he, hc⟩ := hC _ hx
    refine ⟨(b.mem_positiveDegrees_monoid n).mpr fun a => ?_, hj ?_⟩
    · have ha := hc a
      simp only [AddMonoidHom.coe_prodMap, Prod.map_apply, hB] at ha
      exact_mod_cast ha
    · exact he.trans (hi.extend_apply j f n)

end Module.Basis
