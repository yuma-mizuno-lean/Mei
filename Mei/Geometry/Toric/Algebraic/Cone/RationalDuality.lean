public import Mei.Geometry.Convex.Cone.FiniteDuality
public import TauCeti.Geometry.Toric.Algebraic.Cone.Basic

/-!
# Integral inequalities and lattice generators

A real cone is generated by finitely many lattice vectors exactly when it is
cut out by finitely many integral-character inequalities. Integral halfspace
cuts preserve lattice generators: the opposite-sign boundary combinations are
images of actual integer combinations of the original lattice vectors.

Applying this construction to the dual integral lattice and using algebraic
bipolarity gives both directions. No salience or topological hypothesis is
needed. All inequalities here are homogeneous; arbitrary real affine offsets
are not part of this statement.
-/

public section

namespace TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {C : PointedCone ℝ V}

/-- A finite generating set contained in the lattice image gives an actual
finite lattice generating presentation. -/
theorem isLatticeRational_hull_of_forall_mem_range (s : Finset V)
    (hs : ∀ x ∈ s, ∃ n : N, i n = x) :
    IsLatticeRational i (PointedCone.hull ℝ (s : Set V)) := by
  classical
  choose n hn using (fun x : s => hs x.val x.property)
  let t : Finset N := Finset.univ.image n
  have he : i '' (t : Set N) = (s : Set V) := by
    ext x
    constructor
    · rintro ⟨m, hm, rfl⟩
      obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hm
      rw [hn j]
      exact j.property
    · intro hx
      exact ⟨n ⟨x, hx⟩, Finset.mem_image.mpr ⟨⟨x, hx⟩, Finset.mem_univ _, rfl⟩, hn _⟩
  exact isLatticeRational_iff.mpr ⟨t, by rw [he]⟩

/-- Cutting a lattice-rational cone by an integral-character halfspace keeps
an actual finite family of lattice generators, with lineality allowed. -/
theorem IsLatticeRational.inf_realCharacter_halfspace (hC : IsLatticeRational i C)
    (h : IsIntegralLattice i) (m : N →+ ℤ) :
    IsLatticeRational i (C ⊓ PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V) {h.realCharacter m}) := by
  classical
  obtain ⟨s, rfl⟩ := isLatticeRational_iff.mp hC
  rw [← Finset.coe_image, ← PointedCone.hull_halfspaceGenerators]
  apply isLatticeRational_hull_of_forall_mem_range
  intro x hx
  rcases PointedCone.mem_halfspaceGenerators_iff.mp hx with ⟨hx, _⟩ | ⟨u, hu, v, hv, _, _, rfl⟩
  · obtain ⟨n, _, rfl⟩ := Finset.mem_image.mp hx
    exact ⟨n, rfl⟩
  · obtain ⟨u, _, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨v, _, rfl⟩ := Finset.mem_image.mp hv
    refine ⟨(-m v) • u + m u • v, ?_⟩
    simp only [map_add, map_zsmul, PointedCone.boundaryCombination_def,
      h.realCharacter_apply, ← Int.cast_neg, Int.cast_smul_eq_zsmul]

/-- The full ambient space of an integral lattice is generated as a cone by
the images of a finite integral basis and its negatives. -/
theorem IsIntegralLattice.isLatticeRational_top (h : IsIntegralLattice i) :
    IsLatticeRational i (⊤ : PointedCone ℝ V) := by
  classical
  let _ := h.free
  let _ := h.finite
  let b := Module.Free.chooseBasis ℤ N
  let B := h.isBaseChange.basis b
  let t : Finset N := Finset.univ.image b ∪ Finset.univ.image (fun j => -b j)
  let D := PointedCone.hull ℝ (i '' (t : Set N))
  have hB (j) : B j = i (b j) := by
    simpa only [B, AddMonoidHom.coe_toIntLinearMap] using h.isBaseChange.basis_apply b j
  have hpos (j) : B j ∈ D := by
    rw [hB]
    apply PointedCone.subset_hull
    exact ⟨b j, Finset.mem_union_left _ (Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩), rfl⟩
  have hneg (j) : -B j ∈ D := by
    rw [hB]
    apply PointedCone.subset_hull
    exact ⟨-b j, Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩), by simp⟩
  apply isLatticeRational_iff.mpr
  refine ⟨t, le_antisymm ?_ le_top⟩
  intro x _
  change x ∈ D
  rw [← B.sum_repr x]
  apply D.sum_mem
  intro j _
  rcases le_total 0 (B.repr x j) with hj | hj
  · exact PointedCone.smul_mem D hj (hpos j)
  · have hm := PointedCone.smul_mem D (neg_nonneg.mpr hj) (hneg j)
    simpa only [neg_smul, smul_neg, neg_neg] using hm

/-- A finite family of integral-character inequalities defines a cone with
finitely many actual lattice generators. -/
theorem IsIntegralLattice.isLatticeRational_dual_image (h : IsIntegralLattice i)
    (s : Finset (N →+ ℤ)) :
    IsLatticeRational i (PointedCone.dual
      (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
      (h.realCharacter '' (s : Set (N →+ ℤ)))) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using h.isLatticeRational_top
  | @insert m s hm ih =>
    rw [Finset.coe_insert, Set.image_insert_eq, PointedCone.dual_insert, inf_comm]
    exact ih.inf_realCharacter_halfspace h m

/-- The algebraic dual of a lattice-rational cone is lattice rational in the
integral dual lattice. Its defining cuts are evaluations at lattice generators. -/
theorem IsLatticeRational.dual (hC : IsLatticeRational i C) (h : IsIntegralLattice i) :
    IsLatticeRational h.realCharacter (PointedCone.dual (Module.Dual.eval ℝ V) C) := by
  classical
  obtain ⟨s, rfl⟩ := isLatticeRational_iff.mp hC
  let t : Finset ((N →+ ℤ) →+ ℤ) := s.image (fun n => AddMonoidHom.eval n)
  have he : PointedCone.dual (Module.Dual.eval ℝ V)
      (PointedCone.hull ℝ (i '' (s : Set N))) =
      PointedCone.dual
        (LinearMap.id : Module.Dual ℝ (Module.Dual ℝ V) →ₗ[ℝ] Module.Dual ℝ (Module.Dual ℝ V))
        (h.dual.realCharacter '' (t : Set ((N →+ ℤ) →+ ℤ))) := by
    ext f
    simp [t, PointedCone.dual_hull, PointedCone.mem_dual, h.dual_realCharacter_eval]
  rw [he]
  exact h.dual.isLatticeRational_dual_image t

/-- **Rational Minkowski–Weyl:** a cone is generated by finitely many lattice
vectors exactly when it is cut out by finitely many integral-character inequalities.
No salience is required. -/
theorem isLatticeRational_iff_exists_dual_image (h : IsIntegralLattice i) :
    IsLatticeRational i C ↔ ∃ s : Finset (N →+ ℤ),
      C = PointedCone.dual (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V)
        (h.realCharacter '' (s : Set (N →+ ℤ))) := by
  constructor
  · intro hC
    obtain ⟨s, hs⟩ := isLatticeRational_iff.mp (hC.dual h)
    have heval : (LinearMap.id : Module.Dual ℝ V →ₗ[ℝ] Module.Dual ℝ V).flip =
        Module.Dual.eval ℝ V := by
      ext x f
      rfl
    have hbip := hC.fg.cone_dual_dual_flip_id
    rw [heval, hs, PointedCone.dual_hull] at hbip
    exact ⟨s, hbip.symm⟩
  · rintro ⟨s, rfl⟩
    exact h.isLatticeRational_dual_image s

end TauCeti.Toric
