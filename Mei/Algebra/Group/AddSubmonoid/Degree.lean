module

public import Mathlib.Algebra.Group.Submonoid.Finsupp
public import Mathlib.Data.Finsupp.Weight
public import TauCeti.Algebra.Group.Submonoid.Closure
public import TauCeti.Algebra.Group.Submonoid.PositiveDegree

import Mathlib.Algebra.Order.Ring.Int

/-!
# Positive integral degrees on finitely generated additive submonoids

An additive integral degree which is strictly positive on nonzero elements of a finitely
generated submonoid has finite sublevel sets. For a finite set of positive-degree generators,
we identify each sublevel set with the image of the bounded-weight coefficient vectors.
This gives finite cutoffs for graded constructions without a freeness or saturation assumption.

The proofs use Mathlib's `AddSubmonoid.mem_closure_range_iff` for generator expressions and
`Finsupp.finite_of_nat_weight_le` for finiteness of bounded-weight coefficient vectors.
-/

public section

namespace AddSubmonoid

variable {M : Type*} [AddCommMonoid M]

/-- A degree cutoff in the submonoid generated by `s` is the image of the coefficient vectors
whose weight, using the degrees of the generators, is bounded by the cutoff. -/
theorem setOf_mem_closure_degree_le_eq_image (s : Finset M) (δ : M →+ ℤ)
    (hδ : ∀ x ∈ s, 0 ≤ δ x) (k : ℕ) :
    {x | x ∈ closure (s : Set M) ∧ δ x ≤ k} =
      Finsupp.weight (fun x : s => (x : M)) ''
        {a : s →₀ ℕ | Finsupp.weight (fun x : s => (δ x).toNat) a ≤ k} := by
  have hweight (a : s →₀ ℕ) :
      δ (Finsupp.weight (fun x : s => (x : M)) a) =
        (Finsupp.weight (fun x : s => (δ x).toNat) a : ℤ) := by
    simp only [Finsupp.weight_apply, Finsupp.sum, map_sum, map_nsmul,
      Nat.cast_sum, nsmul_eq_mul, Nat.cast_mul, Nat.cast_id,
      Int.toNat_of_nonneg (hδ _ (Subtype.prop _))]
  ext x
  constructor
  · rintro ⟨hx, hle⟩
    rw [← Subtype.range_coe (s := (s : Set M)), mem_closure_range_iff] at hx
    obtain ⟨a, ha⟩ := hx
    have ha' : Finsupp.weight (fun x : s => (x : M)) a = x :=
      (Finsupp.weight_apply _ _).trans ha.symm
    refine ⟨a, ?_, ha'⟩
    rw [← ha', hweight] at hle
    exact_mod_cast hle
  · rintro ⟨a, ha, rfl⟩
    constructor
    · rw [← Subtype.range_coe (s := (s : Set M)), mem_closure_range_iff]
      exact ⟨a, Finsupp.weight_apply _ _⟩
    · rw [hweight]
      exact_mod_cast ha

/-- Finitely many positive-degree generators give finite degree cutoffs. -/
theorem finite_setOf_mem_closure_degree_le (s : Finset M) (δ : M →+ ℤ)
    (hδ : ∀ x ∈ s, 0 < δ x) (k : ℕ) :
    {x | x ∈ closure (s : Set M) ∧ δ x ≤ k}.Finite := by
  rw [setOf_mem_closure_degree_le_eq_image s δ (fun x hx => (hδ x hx).le) k]
  exact (Finsupp.finite_of_nat_weight_le _
    (fun x : s => by have := hδ x x.prop; omega) k).image _

end AddSubmonoid
