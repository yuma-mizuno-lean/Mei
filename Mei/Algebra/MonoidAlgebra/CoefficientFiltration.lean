module

public import Mathlib.Algebra.Order.Ring.Int
public import Mei.Algebra.MonoidAlgebra.Derivation
public import Mei.RingTheory.FilteredAlgebra.Basic
public import Mathlib.Algebra.MonoidAlgebra.Ideal
import Mathlib.Algebra.MonoidAlgebra.Support

/-!
# Positive-order filtrations on coefficient monoid algebras

For additive submonoids `P, Q ≤ N` and an additive degree `δ : N →+ ℤ`, filter
`R[Q]` by the ideals generated by monomials in `P ∩ Q` of degree at least `k`.
Membership means that every supported exponent is the sum of such an exponent
and an exponent in `Q`. In the usual application `P` is the positive monoid
and `P ≤ Q`; for `Q = P` and `δ` nonnegative on `P`, this is exactly the degree
cutoff. Larger coefficient monoids can contain negative degrees, so the
filtration need not be separated. No finiteness or strict positivity is needed.

Monomial logarithmic derivations of positive degree raise this filtration by
their degree. This gives the coefficient filtration needed to exponentiate
positive logarithmic vector fields on completed monoid algebras.

The construction uses Mathlib's `AddMonoidAlgebra.mem_ideal_span_of'_image`
and `support_coeff_mul_subset`, and the monomial derivations in
`Mei.Algebra.MonoidAlgebra.Derivation`. The coefficient-ideal construction follows
Travis Mandel, *Scattering diagrams, theta functions, and refined tropical curve
counts*, §2.1 and Example 2.1(i), arXiv:1503.06183v5.
-/

public section

noncomputable section

open AddMonoidAlgebra

namespace AddSubmonoid

variable {N R : Type*} [AddCommMonoid N] [CommSemiring R]
  (P Q : AddSubmonoid N) (δ : N →+ ℤ)

/-- The ideal generated by monomials in `P ∩ Q` whose degree is at least `k`.
The coefficient monoid may contain degrees outside the generating monoid `P`. -/
def coefficientIdeal (k : ℕ) : Ideal R[Q] :=
  Ideal.span (of' R Q '' {n : Q | n.val ∈ P ∧ (k : ℤ) ≤ δ n.val})

/-- The coefficient ideal is the span of monomials in `P ∩ Q` of degree at least `k`. -/
theorem coefficientIdeal_def (k : ℕ) :
    P.coefficientIdeal (R := R) Q δ k =
      Ideal.span (of' R Q '' {n : Q | n.val ∈ P ∧ (k : ℤ) ≤ δ n.val}) := (rfl)

/-- An ideal contains the coefficient ideal exactly when it contains every generating monomial. -/
theorem coefficientIdeal_le_iff (k : ℕ) (J : Ideal R[Q]) :
    P.coefficientIdeal Q δ k ≤ J ↔
      ∀ n : Q, n.val ∈ P → (k : ℤ) ≤ δ n.val → of' R Q n ∈ J := by
  rw [coefficientIdeal_def, Ideal.span_le]
  constructor
  · intro h n hn hk
    exact h (Set.mem_image_of_mem _ ⟨hn, hk⟩)
  · rintro h _ ⟨n, ⟨hn, hk⟩, rfl⟩
    exact h n hn hk

/-- An element has order at least `k` precisely when each supported exponent
is a translate in `Q` of an exponent in `P` of degree at least `k`. -/
theorem mem_coefficientIdeal_iff (k : ℕ) (a : R[Q]) :
    a ∈ P.coefficientIdeal Q δ k ↔ ∀ q ∈ a.coeff.support,
      ∃ n : Q, n.val ∈ P ∧ (k : ℤ) ≤ δ n.val ∧
        ∃ q₀ : Q, q = q₀ + n := by
  simp only [coefficientIdeal, mem_ideal_span_of'_image, Set.mem_ofPred_eq, and_assoc]

/-- A monomial lies in the coefficient ideal whenever its exponent has a
summand in `P` of sufficiently large degree. -/
theorem single_mem_coefficientIdeal {k : ℕ} {q n : Q}
    (hn : n.val ∈ P) (hk : (k : ℤ) ≤ δ n.val)
    (hq : ∃ q₀ : Q, q = q₀ + n) (r : R) :
    single q r ∈ P.coefficientIdeal Q δ k := by
  classical
  apply (P.mem_coefficientIdeal_iff Q δ k _).mpr
  intro p hp
  simp only [coeff_single] at hp
  have hpq : p = q := Finset.mem_singleton.mp (Finsupp.support_single_subset hp)
  exact hpq ▸ ⟨n, hn, hk, hq⟩

/-- For a nonzero coefficient, coefficient-ideal membership is exactly the
generating-summand condition on the exponent. -/
@[simp]
theorem single_mem_coefficientIdeal_iff {k : ℕ} {q : Q} {r : R} (hr : r ≠ 0) :
    single q r ∈ P.coefficientIdeal Q δ k ↔
      ∃ n : Q, n.val ∈ P ∧ (k : ℤ) ≤ δ n.val ∧
        ∃ q₀ : Q, q = q₀ + n := by
  classical
  simp only [mem_coefficientIdeal_iff, coeff_single, Finsupp.support_single _ hr,
    Finset.mem_singleton, forall_eq]

/-- Higher cutoffs give smaller coefficient ideals. -/
theorem coefficientIdeal_antitone : Antitone (P.coefficientIdeal (R := R) Q δ) := by
  intro k l hkl
  apply Ideal.span_mono
  exact Set.image_mono fun n hn => ⟨hn.1, (Int.ofNat_le.mpr hkl).trans hn.2⟩

/-- The order-zero coefficient ideal is the whole algebra. -/
@[simp]
theorem coefficientIdeal_zero : P.coefficientIdeal (R := R) Q δ 0 = ⊤ := by
  apply Ideal.eq_top_of_isUnit_mem _ ?_ isUnit_one
  simpa only [one_def] using P.single_mem_coefficientIdeal Q δ
    (q := 0) (n := 0) P.zero_mem (by simp) ⟨0, by simp⟩ (1 : R)

/-- Products add the lower order bounds, even if the coefficient
monoid itself contains negative-degree elements. -/
theorem mul_mem_coefficientIdeal {k l : ℕ} {a b : R[Q]}
    (ha : a ∈ P.coefficientIdeal Q δ k) (hb : b ∈ P.coefficientIdeal Q δ l) :
    a * b ∈ P.coefficientIdeal Q δ (k + l) := by
  classical
  apply (P.mem_coefficientIdeal_iff Q δ (k + l) _).mpr
  intro q hq
  obtain ⟨x, hx, y, hy, rfl⟩ := Finset.mem_add.mp (support_coeff_mul_subset a b hq)
  obtain ⟨n, hn, hkn, x₀, rfl⟩ := (P.mem_coefficientIdeal_iff Q δ k a).mp ha x hx
  obtain ⟨m, hm, hlm, y₀, rfl⟩ := (P.mem_coefficientIdeal_iff Q δ l b).mp hb y hy
  refine ⟨n + m, P.add_mem hn hm, ?_, x₀ + y₀, by simp [add_comm,
    add_left_comm]⟩
  simpa only [AddSubmonoid.coe_add, map_add, Nat.cast_add] using add_le_add hkn hlm

/-- The decreasing multiplicative coefficient filtration. It uses actual
summands in `P`, rather than the ambient degree of a coefficient monomial. -/
def coefficientFiltration : Mei.AlgFiltration R[Q] where
  ideal := P.coefficientIdeal Q δ
  isTwoSided _ := inferInstance
  antitone := P.coefficientIdeal_antitone Q δ
  ideal_zero := P.coefficientIdeal_zero Q δ
  mul_mem := P.mul_mem_coefficientIdeal Q δ

/-- The terms of the coefficient filtration are its generating monomial ideals. -/
@[simp]
theorem coefficientFiltration_ideal (k : ℕ) :
    (P.coefficientFiltration (R := R) Q δ).ideal k = P.coefficientIdeal Q δ k := (rfl)

/-- On the generating monoid itself, if the degree is nonnegative there,
coefficient order is exactly the degree bound on every supported exponent. -/
theorem mem_coefficientIdeal_self_iff_of_nonneg (hδ : ∀ n ∈ P, 0 ≤ δ n)
    (k : ℕ) (a : R[P]) :
    a ∈ P.coefficientIdeal P δ k ↔
      ∀ q ∈ a.coeff.support, (k : ℤ) ≤ δ q.val := by
  rw [mem_coefficientIdeal_iff]
  constructor
  · intro ha q hq
    obtain ⟨n, _, hn, q₀, rfl⟩ := ha q hq
    simpa only [AddSubmonoid.coe_add, map_add] using
      hn.trans (le_add_of_nonneg_left (hδ q₀ q₀.property))
  · intro ha q hq
    exact ⟨q, q.property, ha q hq, 0, by simp⟩

/-- A logarithmic derivation with degree in `P` raises coefficient order by any
natural lower bound on its degree. The character need not annihilate that degree. -/
theorem monomialDerivation_mem_coefficientIdeal {a b : ℕ} {n : Q}
    (hn : n.val ∈ P) (ha : (a : ℤ) ≤ δ n.val)
    (m : Q →+ R) {f : R[Q]} (hf : f ∈ P.coefficientIdeal Q δ b) :
    Mei.AddMonoidAlgebra.monomialDerivation n m f ∈ P.coefficientIdeal Q δ (a + b) := by
  classical
  rw [← f.sum_coeff_single, map_finsuppSum]
  apply (P.coefficientIdeal Q δ (a + b)).sum_mem
  intro q hq
  simp only [Mei.AddMonoidAlgebra.monomialDerivation_single]
  obtain ⟨p, hp, hb, q₀, he⟩ := (P.mem_coefficientIdeal_iff Q δ b f).mp hf q hq
  apply P.single_mem_coefficientIdeal Q δ (n := n + p) (P.add_mem hn hp)
  · simpa only [AddSubmonoid.coe_add, map_add, Nat.cast_add] using add_le_add ha hb
  · exact ⟨q₀, by rw [he]; ac_rfl⟩

end AddSubmonoid
