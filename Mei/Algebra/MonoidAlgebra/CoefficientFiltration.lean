module

public import Mei.Algebra.PositiveDegrees.Basic
public import Mei.Algebra.MonoidAlgebra.Derivation
public import Mei.RingTheory.FilteredAlgebra.Basic
public import Mathlib.Algebra.MonoidAlgebra.Ideal
import Mathlib.Algebra.MonoidAlgebra.Support

/-!
# Positive-order filtrations on coefficient monoid algebras

For positive degree data on `N` and a coefficient monoid `Q ≤ N`, filter `R[Q]`
by the ideals generated by monomials in `P ∩ Q` of degree at least `k`.
Membership means that every supported exponent is the sum of such a positive
exponent and an exponent in `Q`. In the usual application `P ≤ Q`; for `Q = P`
this is exactly the degree cutoff. Larger coefficient monoids can contain
negative degrees, so the filtration need not be separated.

Monomial logarithmic derivations of positive degree raise this filtration by
their degree. This gives the coefficient filtration needed to exponentiate
positive logarithmic vector fields on completed monoid algebras.

The construction uses Mathlib's `AddMonoidAlgebra.mem_ideal_span_of'_image`
and `support_coeff_mul_subset`, and the monomial derivations in
`Mei.Algebra.MonoidAlgebra.Derivation`. The coefficient-ideal construction follows
Travis Mandel, *Scattering diagrams, theta functions, and refined tropical curve
counts*, §2.1 and Example 2.1(i), arXiv:1503.06183v5.
-/

public section

noncomputable section

open AddMonoidAlgebra

namespace Mei.PositiveDegrees

variable {N R : Type*} [AddCommMonoid N] [CommSemiring R]
  (d : PositiveDegrees N) (Q : AddSubmonoid N)

/-- The ideal generated by positive monomials whose degree is at least `k`.
The coefficient monoid may contain degrees outside the positive monoid. -/
def coefficientIdeal (k : ℕ) : Ideal R[Q] :=
  Ideal.span (of' R Q '' {n : Q | n.val ∈ d.monoid ∧ (k : ℤ) ≤ d.degree n.val})

/-- An element has order at least `k` precisely when each supported exponent
is a translate in `Q` of an allowed positive exponent of degree at least `k`. -/
theorem mem_coefficientIdeal_iff (k : ℕ) (a : R[Q]) :
    a ∈ d.coefficientIdeal Q k ↔ ∀ q ∈ a.coeff.support,
      ∃ n : Q, n.val ∈ d.monoid ∧ (k : ℤ) ≤ d.degree n.val ∧
        ∃ q₀ : Q, q = q₀ + n := by
  simp only [coefficientIdeal, mem_ideal_span_of'_image, Set.mem_ofPred_eq, and_assoc]

/-- A monomial lies in the coefficient ideal whenever its exponent has a
positive summand of sufficiently large degree. -/
theorem single_mem_coefficientIdeal {k : ℕ} {q n : Q}
    (hn : n.val ∈ d.monoid) (hk : (k : ℤ) ≤ d.degree n.val)
    (hq : ∃ q₀ : Q, q = q₀ + n) (r : R) :
    single q r ∈ d.coefficientIdeal Q k := by
  classical
  apply (d.mem_coefficientIdeal_iff Q k _).mpr
  intro p hp
  have hpq : p = q := Finset.mem_singleton.mp (Finsupp.support_single_subset hp)
  exact hpq ▸ ⟨n, hn, hk, hq⟩

/-- For a nonzero coefficient, coefficient-ideal membership is exactly the
positive-summand condition on the exponent. -/
@[simp]
theorem single_mem_coefficientIdeal_iff {k : ℕ} {q : Q} {r : R} (hr : r ≠ 0) :
    single q r ∈ d.coefficientIdeal Q k ↔
      ∃ n : Q, n.val ∈ d.monoid ∧ (k : ℤ) ≤ d.degree n.val ∧
        ∃ q₀ : Q, q = q₀ + n := by
  classical
  simp only [mem_coefficientIdeal_iff, coeff_single, Finsupp.support_single _ hr,
    Finset.mem_singleton, forall_eq]

/-- Higher cutoffs give smaller coefficient ideals. -/
theorem coefficientIdeal_antitone : Antitone (d.coefficientIdeal (R := R) Q) := by
  intro k l hkl
  apply Ideal.span_mono
  exact Set.image_mono fun n hn => ⟨hn.1, (Int.ofNat_le.mpr hkl).trans hn.2⟩

/-- The order-zero coefficient ideal is the whole algebra. -/
@[simp]
theorem coefficientIdeal_zero : d.coefficientIdeal (R := R) Q 0 = ⊤ := by
  apply Ideal.eq_top_of_isUnit_mem _ ?_ isUnit_one
  simpa only [one_def] using d.single_mem_coefficientIdeal Q
    (q := 0) (n := 0) d.monoid.zero_mem (by simp) ⟨0, by simp⟩ (1 : R)

/-- Products add the lower positive-order bounds, even if the coefficient
monoid itself contains negative-degree elements. -/
theorem mul_mem_coefficientIdeal {k l : ℕ} {a b : R[Q]}
    (ha : a ∈ d.coefficientIdeal Q k) (hb : b ∈ d.coefficientIdeal Q l) :
    a * b ∈ d.coefficientIdeal Q (k + l) := by
  classical
  apply (d.mem_coefficientIdeal_iff Q (k + l) _).mpr
  intro q hq
  obtain ⟨x, hx, y, hy, rfl⟩ := Finset.mem_add.mp (support_coeff_mul_subset a b hq)
  obtain ⟨n, hn, hkn, x₀, rfl⟩ := (d.mem_coefficientIdeal_iff Q k a).mp ha x hx
  obtain ⟨m, hm, hlm, y₀, rfl⟩ := (d.mem_coefficientIdeal_iff Q l b).mp hb y hy
  refine ⟨n + m, d.monoid.add_mem hn hm, ?_, x₀ + y₀, by simp [add_comm,
    add_left_comm]⟩
  simpa only [AddSubmonoid.coe_add, map_add, Nat.cast_add] using add_le_add hkn hlm

/-- The decreasing multiplicative coefficient filtration. It uses actual
positive summands, rather than the ambient degree of a coefficient monomial. -/
def coefficientFiltration : AlgFiltration R[Q] where
  ideal := d.coefficientIdeal Q
  isTwoSided _ := inferInstance
  antitone := d.coefficientIdeal_antitone Q
  ideal_zero := d.coefficientIdeal_zero Q
  mul_mem := d.mul_mem_coefficientIdeal Q

/-- The terms of the coefficient filtration are its positive monomial ideals. -/
@[simp]
theorem coefficientFiltration_ideal (k : ℕ) :
    (d.coefficientFiltration (R := R) Q).ideal k = d.coefficientIdeal Q k := (rfl)

/-- On the positive monoid itself, coefficient order is exactly the ordinary
degree bound on every supported exponent. -/
theorem mem_coefficientIdeal_positive_iff (k : ℕ) (a : R[d.monoid]) :
    a ∈ d.coefficientIdeal d.monoid k ↔
      ∀ q ∈ a.coeff.support, (k : ℤ) ≤ d.degree q.val := by
  rw [mem_coefficientIdeal_iff]
  constructor
  · intro ha q hq
    obtain ⟨n, _, hn, q₀, rfl⟩ := ha q hq
    simpa only [AddSubmonoid.coe_add, map_add] using
      hn.trans (le_add_of_nonneg_left (d.degree_nonneg q₀.property))
  · intro ha q hq
    exact ⟨q, q.property, ha q hq, 0, by simp⟩

/-- A positive logarithmic derivation raises coefficient order by any lower
bound on its degree. The character need not annihilate that degree. -/
theorem monomialDerivation_mem_coefficientIdeal {a b : ℕ} {n : Q}
    (hn : n.val ∈ d.monoid) (ha : (a : ℤ) ≤ d.degree n.val)
    (m : Q →+ R) {f : R[Q]} (hf : f ∈ d.coefficientIdeal Q b) :
    Mei.AddMonoidAlgebra.monomialDerivation n m f ∈ d.coefficientIdeal Q (a + b) := by
  classical
  rw [← f.sum_coeff_single, map_finsuppSum]
  apply (d.coefficientIdeal Q (a + b)).sum_mem
  intro q hq
  simp only [Mei.AddMonoidAlgebra.monomialDerivation_single]
  obtain ⟨p, hp, hb, q₀, he⟩ := (d.mem_coefficientIdeal_iff Q b f).mp hf q hq
  apply d.single_mem_coefficientIdeal Q (n := n + p) (d.monoid.add_mem hn hp)
  · simpa only [AddSubmonoid.coe_add, map_add, Nat.cast_add] using add_le_add ha hb
  · exact ⟨q₀, by rw [he]; ac_rfl⟩

end Mei.PositiveDegrees
