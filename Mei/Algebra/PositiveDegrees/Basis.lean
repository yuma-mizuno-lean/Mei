public import Mathlib.LinearAlgebra.TensorProduct.Basis

/-!
# Positive degrees from an integral basis

A finite integral basis defines the monoid of nonnegative integral combinations,
graded by the sum of its coordinates. Its bounded-degree sets are finite, including
when the basis is empty. These are the degree data for completions in independent
formal variables. The construction pulls back `TauCeti.PositiveDegrees.orthant` along
Mathlib's `Module.Basis.equivFun`. The allowed monoid is free on the basis vectors:
`Module.Basis.positiveDegreesMonoidEquiv` identifies it with `ι →₀ ℕ`, carrying the degree
to the total degree. For the standard basis of `ℤ × ℤ` the allowed exponents are the pairs with
nonnegative coordinates (`Module.Basis.mem_positiveDegrees_finTwoProd_monoid`).
For elements `aⱼ` of a commutative monoid, the monomial weight `n ↦ ∏ⱼ aⱼ^{nⱼ}`
(`Module.Basis.monomialWeight`) is multiplicative on the allowed monoid
(`Module.Basis.monomialWeight_add`). For graphs in a torsion-free target, every supported
primitive ray generator already belongs to the graph monoid. The allowed monoid spans `ℚ ⊗ N`
(`Module.Basis.span_tmul_positiveDegrees_monoid`). Nonzero allowed degrees `vⱼ` of positive degree
data `d` define the positive degree map `n ↦ ∑ⱼ nⱼ vⱼ` with identity cutoff modulus
(`Module.Basis.positiveDegreeMap`).
-/

public section

noncomputable section

namespace Module.Basis

variable {ι N : Type*} [Fintype ι] [AddCommGroup N] (b : Basis ι ℤ N)

/-- The nonnegative basis monoid, with coordinate-sum degree. -/
def positiveDegrees : TauCeti.PositiveDegrees N where
  monoid := (TauCeti.PositiveDegrees.orthant ι).monoid.comap b.equivFun.toAddMonoidHom
  degree := (TauCeti.PositiveDegrees.orthant ι).degree.comp b.equivFun.toAddMonoidHom
  degree_pos hn hne := (TauCeti.PositiveDegrees.orthant ι).degree_pos hn
    (fun h => hne (b.equivFun.injective (h.trans (map_zero _).symm)))
  finite_le k := (TauCeti.PositiveDegrees.orthant ι).finite_le k |>.preimage
    b.equivFun.injective.injOn

/-- Allowed exponents have nonnegative coordinates in the chosen basis. -/
@[simp]
theorem mem_positiveDegrees_monoid (n : N) :
    n ∈ b.positiveDegrees.monoid ↔ ∀ j, 0 ≤ b.repr n j := by
  simp [positiveDegrees, equivFun_apply]

/-- A nonnegative integer multiple of a basis vector is an allowed exponent. -/
theorem zsmul_mem_positiveDegrees_monoid (j : ι) {a : ℤ} (ha : 0 ≤ a) :
    a • b j ∈ b.positiveDegrees.monoid := by
  classical
  rw [mem_positiveDegrees_monoid]
  intro i
  rw [map_zsmul, repr_self, Finsupp.smul_apply, smul_eq_mul, Finsupp.single_apply]
  split_ifs <;> simp [ha]

/-- For the standard basis of `ℤ × ℤ`, the allowed exponents are the pairs with nonnegative
coordinates. -/
theorem mem_positiveDegrees_finTwoProd_monoid (x : ℤ × ℤ) :
    x ∈ (Basis.finTwoProd ℤ).positiveDegrees.monoid ↔ 0 ≤ x.1 ∧ 0 ≤ x.2 := by
  simp [mem_positiveDegrees_monoid, Fin.forall_fin_two]

/-- Degree is the sum of the integral basis coordinates. -/
@[simp]
theorem positiveDegrees_degree (n : N) :
    b.positiveDegrees.degree n = ∑ j, b.repr n j := by
  simp [positiveDegrees, equivFun_apply]

/-- The allowed monoid is exactly the monoid generated by the basis vectors. -/
theorem positiveDegrees_monoid_eq_closure :
    b.positiveDegrees.monoid = AddSubmonoid.closure (Set.range b) := by
  classical
  apply le_antisymm
  · intro n hn
    rw [← b.sum_repr n]
    apply AddSubmonoid.sum_mem
    intro j _
    have hj := (b.mem_positiveDegrees_monoid n).mp hn j
    have hb := AddSubmonoid.nsmul_mem (AddSubmonoid.closure (Set.range b))
      (AddSubmonoid.subset_closure (Set.mem_range_self j)) (b.repr n j).toNat
    simpa only [← Nat.cast_smul_eq_nsmul ℤ, Int.toNat_of_nonneg hj] using hb
  · apply AddSubmonoid.closure_le.mpr
    rintro _ ⟨j, rfl⟩
    simp [mem_positiveDegrees_monoid, Finsupp.single_apply, ite_nonneg]

/-- The basis vectors are allowed exponents. -/
theorem mem_positiveDegrees_monoid_self (j : ι) : b j ∈ b.positiveDegrees.monoid := by
  classical
  simp [mem_positiveDegrees_monoid, Finsupp.single_apply, ite_nonneg]

/-- The supported primitive ray through an integral basis vector in the
nonnegative basis monoid. -/
def positiveDegreesRay (j : ι) : TauCeti.SupportedRay b.positiveDegrees :=
  TauCeti.SupportedRay.ofMem (b j) (b.mem_positiveDegrees_monoid_self j) (b.isPrimitive j)

/-- The generator of a basis ray is the corresponding basis vector. -/
@[simp]
theorem positiveDegreesRay_generator (j : ι) :
    (b.positiveDegreesRay j).generator = b j := by
  simp [positiveDegreesRay]

/-- The nonnegative basis monoid is saturated under division by positive natural
multiples. -/
theorem nsmulSaturated_positiveDegrees_monoid : b.positiveDegrees.monoid.NSMulSaturated := by
  intro a n hn
  by_cases ha : a = 0
  · exact Or.inl ha
  · right
    apply (b.mem_positiveDegrees_monoid n).mpr
    intro c
    have hc := (b.mem_positiveDegrees_monoid _).mp hn c
    simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hc
    exact nonneg_of_mul_nonneg_right hc (by exact_mod_cast Nat.pos_of_ne_zero ha)

/-- Free natural coordinates on the nonnegative basis monoid: an allowed exponent is
recorded by its basis coordinates, which are natural numbers. -/
def positiveDegreesMonoidEquiv : b.positiveDegrees.monoid ≃+ (ι →₀ ℕ) where
  toFun n := (b.repr n).mapRange Int.toNat Int.toNat_zero
  invFun c := ⟨b.repr.symm (c.mapRange (↑) Nat.cast_zero), by simp⟩
  left_inv n := by
    ext1
    apply b.repr.injective
    ext j
    simp [Int.toNat_of_nonneg ((b.mem_positiveDegrees_monoid _).mp n.property j)]
  right_inv c := by
    ext j
    simp
  map_add' n m := by
    ext j
    simp [Int.toNat_add ((b.mem_positiveDegrees_monoid _).mp n.property j)
      ((b.mem_positiveDegrees_monoid _).mp m.property j)]

/-- The natural coordinates of an allowed exponent are its basis coordinates. -/
@[simp]
theorem positiveDegreesMonoidEquiv_apply (n : b.positiveDegrees.monoid) (j : ι) :
    b.positiveDegreesMonoidEquiv n j = (b.repr n j).toNat :=
  (rfl)

/-- The allowed exponent with natural coordinates `c` has basis coordinates `c`. -/
@[simp]
theorem repr_positiveDegreesMonoidEquiv_symm_apply (c : ι →₀ ℕ) (j : ι) :
    b.repr (b.positiveDegreesMonoidEquiv.symm c) j = c j := by
  simp [positiveDegreesMonoidEquiv]

section MonomialWeight

variable {R : Type*} [CommMonoid R] (a : ι → R)

/-- The monomial weight `n ↦ ∏ⱼ aⱼ ^ nⱼ` of the basis coordinates `nⱼ` of `n`; negative
coordinates are replaced by zero. On an allowed exponent it is the monomial in the `aⱼ` with the
natural coordinates of `n` as exponents. -/
def monomialWeight (n : N) : R :=
  ∏ j, a j ^ (b.repr n j).toNat

/-- The monomial weight is the product of the powers of the `aⱼ` by the truncated coordinates. -/
theorem monomialWeight_def (n : N) : b.monomialWeight a n = ∏ j, a j ^ (b.repr n j).toNat :=
  (rfl)

/-- The monomial weight is multiplicative on allowed exponents. -/
theorem monomialWeight_add {n m : N} (hn : n ∈ b.positiveDegrees.monoid)
    (hm : m ∈ b.positiveDegrees.monoid) :
    b.monomialWeight a (n + m) = b.monomialWeight a n * b.monomialWeight a m := by
  simp only [monomialWeight_def, ← Finset.prod_mul_distrib, ← pow_add, map_add,
    Finsupp.add_apply, Int.toNat_add ((b.mem_positiveDegrees_monoid _).mp hn _)
      ((b.mem_positiveDegrees_monoid _).mp hm _)]

/-- The monomial weight of a basis vector `bⱼ` is `aⱼ`. -/
@[simp]
theorem monomialWeight_self (j : ι) : b.monomialWeight a (b j) = a j := by
  classical
  rw [monomialWeight_def, Finset.prod_eq_single j (fun i _ hi => by simp [hi]) (by simp)]
  simp

/-- If every `aⱼ` lies in a submonoid, so does the monomial weight of every element. -/
theorem monomialWeight_mem {S : Type*} [SetLike S R] [SubmonoidClass S R] {s : S}
    (ha : ∀ j, a j ∈ s) (n : N) : b.monomialWeight a n ∈ s :=
  prod_mem fun j _ => pow_mem (ha j) _

end MonomialWeight

/-- The degree of an allowed exponent is the total degree of its natural coordinates. -/
theorem positiveDegrees_degree_eq_degree_positiveDegreesMonoidEquiv
    (n : b.positiveDegrees.monoid) :
    b.positiveDegrees.degree n = ((b.positiveDegreesMonoidEquiv n).degree : ℤ) := by
  simp [Finsupp.degree_eq_sum,
    Int.toNat_of_nonneg ((b.mem_positiveDegrees_monoid _).mp n.property _)]

/-- Supported primitive generators belong to the basis graph monoid when the
target is torsion-free. This integral membership does not require real embeddings. -/
theorem supportedRay_generator_mem_positiveDegrees_graph
    {M : Type*} [AddCommGroup M] [Module.IsTorsionFree ℤ M] (f : N →+ M)
    (w : TauCeti.SupportedRay (b.positiveDegrees.graph f)) :
    w.generator ∈ (b.positiveDegrees.graph f).monoid := by
  let := HasUniqueDiv.of_isTorsionFree ℤ M
  exact w.generator_mem_of_nsmulSaturated
    (b.positiveDegrees.nsmulSaturated_graph_monoid f b.nsmulSaturated_positiveDegrees_monoid)

open scoped TensorProduct in
/-- The rationalized nonnegative basis monoid spans the rational vector space `ℚ ⊗ N`. -/
theorem span_tmul_positiveDegrees_monoid :
    Submodule.span ℚ ((fun p : N => (1 : ℚ) ⊗ₜ[ℤ] p) '' (b.positiveDegrees.monoid : Set N)) =
      ⊤ := by
  refine eq_top_iff.mpr ((b.baseChange ℚ).span_eq.symm.le.trans (Submodule.span_mono ?_))
  rintro _ ⟨j, rfl⟩
  rw [baseChange_apply]
  exact Set.mem_image_of_mem _ (b.mem_positiveDegrees_monoid_self j)

section DegreeMap

variable {Γ : Type*} [AddCommGroup Γ] {d : TauCeti.PositiveDegrees Γ} (v : ι → Γ)
  (hv : ∀ j, v j ∈ d.monoid) (hv0 : ∀ j, v j ≠ 0)

include hv hv0 in
/-- On the nonnegative basis monoid, the additive map `n ↦ ∑ⱼ nⱼ vⱼ` sending each basis vector
`bⱼ` to a nonzero allowed degree `vⱼ` of `d` does not decrease the degree. -/
theorem degree_le_degree_constr {n : N} (hn : n ∈ b.positiveDegrees.monoid) :
    b.positiveDegrees.degree n ≤ d.degree (b.constr ℤ v n) := by
  rw [positiveDegrees_degree, constr_apply_fintype, map_sum]
  refine Finset.sum_le_sum fun j _ => ?_
  rw [equivFun_apply, map_zsmul, smul_eq_mul]
  exact le_mul_of_one_le_right ((b.mem_positiveDegrees_monoid n).mp hn j)
    (d.degree_pos (hv j) (hv0 j))

include hv in
/-- The additive map `n ↦ ∑ⱼ nⱼ vⱼ` sends the nonnegative basis monoid into the allowed degrees
when every `vⱼ` is allowed. -/
theorem constr_mem_monoid {n : N} (hn : n ∈ b.positiveDegrees.monoid) :
    b.constr ℤ v n ∈ d.monoid := by
  rw [constr_apply_fintype]
  refine AddSubmonoid.sum_mem _ fun j _ => ?_
  rw [equivFun_apply, ← Int.toNat_of_nonneg ((b.mem_positiveDegrees_monoid n).mp hn j),
    natCast_zsmul]
  exact AddSubmonoid.nsmul_mem _ (hv j) _

/-- The additive map `n ↦ ∑ⱼ nⱼ vⱼ` sending each basis vector `bⱼ` to a nonzero allowed degree
`vⱼ` of `d`, as a positive degree map from the nonnegative basis monoid with the identity cutoff
modulus `k ↦ 1 * k`. -/
def positiveDegreeMap : TauCeti.PositiveDegreeMap b.positiveDegrees d :=
  TauCeti.PositiveDegreeMap.ofBound (b.constr ℤ v).toAddMonoidHom
    (fun _ hn => b.constr_mem_monoid v hv hn) 1
    (fun _ hn => by simpa using b.degree_le_degree_constr v hv hv0 hn)

/-- The positive degree map of a basis sends `n` to `∑ⱼ nⱼ vⱼ`. -/
@[simp]
theorem positiveDegreeMap_apply (n : N) :
    b.positiveDegreeMap v hv hv0 n = b.constr ℤ v n := by
  rw [positiveDegreeMap]
  exact TauCeti.PositiveDegreeMap.ofBound_apply _ _ _ _ n

/-- The positive degree map of a basis sends the basis vector `bⱼ` to `vⱼ`. -/
theorem positiveDegreeMap_self (j : ι) : b.positiveDegreeMap v hv hv0 (b j) = v j := by
  rw [positiveDegreeMap_apply, constr_basis]

/-- The positive degree map of a basis has the identity cutoff modulus. -/
@[simp]
theorem positiveDegreeMap_modulus (k : ℕ) : (b.positiveDegreeMap v hv hv0).modulus k = k := by
  rw [positiveDegreeMap]
  exact (TauCeti.PositiveDegreeMap.ofBound_modulus _ _ _ _ k).trans (one_mul k)

end DegreeMap

end Module.Basis
