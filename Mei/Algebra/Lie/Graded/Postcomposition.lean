module

public import Mathlib.Algebra.Lie.Abelian
public import Mathlib.Algebra.Lie.Graded
public import Mathlib.Algebra.Lie.Submodule
public import TauCeti.Algebra.DirectSum.Internal

/-!
# Graded homomorphism modules with the action through the target

Let `L` be a graded Lie algebra acting on a module `M` with a grading `ℳ`, and let `X` be an
`R`-module on which `L` acts trivially. The `R`-linear maps `X → M` form a Lie module over `L`
by `⁅x, f⁆ v = ⁅x, f v⁆`: this is the Lie module structure of Mathlib's
`LinearMap.instLieRingModule` for the trivial module `X`, see `lie_linearMap_apply`.

The maps with values in a single piece `ℳ q` form the submodules `homPiece ℳ X q`, and
`gradedHom ℒ ℳ X` is the Lie submodule they generate. Its elements are the maps whose values have
homogeneous components in only finitely many degrees in total
(`mem_gradedHom_iff_exists_finset`); this is all of `X →ₗ[R] M` when the grading is finite or `X`
is finitely generated. The sub-Lie module `gradedHom ℒ ℳ X` is the internal direct sum of the
pieces `gradedHomPiece ℒ ℳ X q` (maps with values in `ℳ q`), and the bracket with a homogeneous
element shifts their degree (`SetLike.GradedBracket`). The homogeneous components of a map are the
componentwise ones (`decompose_gradedHomPiece_apply`).

Evaluation at `v : X` is an equivariant linear map `gradedHomEval ℒ ℳ X v` carrying the piece of
degree `q` into `ℳ q`; equivariance holds because `L` acts only on the target.

Mathlib's `TrivialLieModule R L X` gives an arbitrary module `X` the trivial action.
-/

public section

noncomputable section

namespace Mei

section Pieces

variable {R L M Γ : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [AddCommGroup M]
  [Module R M] [LieRingModule L M] [LieModule R L M] (ℳ : Γ → Submodule R M)
  {X : Type*} [AddCommGroup X] [Module R X] [LieRingModule L X] [LieModule R L X]
  [LieModule.IsTrivial L X]

omit ℳ in
/-- If `L` acts trivially on `X`, it acts on a linear map `f : X → M` through the target.
It specializes `LieHom.lie_apply`, which is the simp normal form for general
Lie modules `X`. -/
theorem lie_linearMap_apply (x : L) (f : X →ₗ[R] M) (v : X) : ⁅x, f⁆ v = ⁅x, f v⁆ := by
  simp [LieHom.lie_apply, trivial_lie_zero]

variable (X)

/-- The linear maps `X → M` with all values in the homogeneous piece `ℳ q`. -/
def homPiece (q : Γ) : Submodule R (X →ₗ[R] M) where
  carrier := {f | ∀ v, f v ∈ ℳ q}
  add_mem' ha hb v := (ℳ q).add_mem (ha v) (hb v)
  zero_mem' _ := (ℳ q).zero_mem
  smul_mem' c _ hf v := (ℳ q).smul_mem c (hf v)

variable {X}

/-- A linear map lies in `homPiece ℳ X q` when all its values lie in `ℳ q`. -/
@[simp]
theorem mem_homPiece {q : Γ} {f : X →ₗ[R] M} : f ∈ homPiece ℳ X q ↔ ∀ v, f v ∈ ℳ q := Iff.rfl

end Pieces

section Graded

variable {R L M Γ : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [AddCommGroup M]
  [Module R M] [LieRingModule L M] [LieModule R L M] [DecidableEq Γ] [AddCommMonoid Γ]
  (ℒ : Γ → Submodule R L) [GradedLieAlgebra ℒ] (ℳ : Γ → Submodule R M)
  [SetLike.GradedBracket ℒ ℳ] (X : Type*) [AddCommGroup X] [Module R X] [LieRingModule L X]
  [LieModule R L X] [LieModule.IsTrivial L X]

omit [DecidableEq Γ] [GradedLieAlgebra ℒ] in
/-- A homogeneous element sends `homPiece ℳ X q` into `homPiece ℳ X (i + q)`. -/
theorem lie_mem_homPiece {i q : Γ} {x : L} (hx : x ∈ ℒ i) {f : X →ₗ[R] M}
    (hf : f ∈ homPiece ℳ X q) : ⁅x, f⁆ ∈ homPiece ℳ X (i + q) :=
  fun v => by
    simpa only [lie_linearMap_apply, vadd_eq_add] using
      SetLike.GradedBracket.bracket_mem hx (hf v)

/-- The linear maps `X → M` whose values have finitely many homogeneous components in total,
as the Lie submodule generated by the pieces `homPiece ℳ X q`. -/
def gradedHom : LieSubmodule R L (X →ₗ[R] M) where
  toSubmodule := ⨆ q, homPiece ℳ X q
  lie_mem {x f} hf := by
    classical
    -- For a homogeneous map the bracket splits along the finitely many components of `x`.
    have hpiece (q : Γ) (g : X →ₗ[R] M) (hg : g ∈ homPiece ℳ X q) :
        ⁅x, g⁆ ∈ ⨆ q, homPiece ℳ X q := by
      rw [← DirectSum.sum_support_decompose ℒ x, sum_lie]
      exact Submodule.sum_mem _ fun i _ => Submodule.mem_iSup_of_mem (i + q)
        (lie_mem_homPiece ℒ ℳ X (DirectSum.decompose ℒ x i).property hg)
    refine Submodule.iSup_induction (homPiece ℳ X) (motive := fun f => ⁅x, f⁆ ∈ ⨆ q,
      homPiece ℳ X q) hf (fun q g hg => hpiece q g hg) (by simp) fun f g hf hg => ?_
    rw [lie_add]
    exact add_mem hf hg

variable {X}

/-- Each piece lies in `gradedHom`. -/
theorem homPiece_le_gradedHom (q : Γ) : homPiece ℳ X q ≤ (gradedHom ℒ ℳ X).toSubmodule :=
  le_iSup (homPiece ℳ X) q

variable (X)

/-- The homogeneous piece of degree `q` of `gradedHom ℒ ℳ X`: the maps with values in `ℳ q`. -/
def gradedHomPiece (q : Γ) : Submodule R (gradedHom ℒ ℳ X) where
  carrier := {f | ∀ v, (f : X →ₗ[R] M) v ∈ ℳ q}
  add_mem' ha hb v := (ℳ q).add_mem (ha v) (hb v)
  zero_mem' _ := (ℳ q).zero_mem
  smul_mem' c _ hf v := (ℳ q).smul_mem c (hf v)

/-- A map in `gradedHom` has degree `q` when all its values lie in `ℳ q`. -/
@[simp]
theorem mem_gradedHomPiece {q : Γ} {f : gradedHom ℒ ℳ X} :
    f ∈ gradedHomPiece ℒ ℳ X q ↔ ∀ v, (f : X →ₗ[R] M) v ∈ ℳ q := Iff.rfl

/-- Evaluation at a vector of `X`, as an equivariant linear map. It is the only place where the
action of `L` on the target is used: `L` acts trivially on `X`. -/
def gradedHomEval (v : X) : gradedHom ℒ ℳ X →ₗ⁅R,L⁆ M where
  toFun f := (f : X →ₗ[R] M) v
  map_add' _ _ := (rfl)
  map_smul' _ _ := (rfl)
  map_lie' {x f} := lie_linearMap_apply x (f : X →ₗ[R] M) v

/-- Evaluation at `v` of a map of `gradedHom`. -/
@[simp]
theorem gradedHomEval_apply (v : X) (f : gradedHom ℒ ℳ X) :
    gradedHomEval ℒ ℳ X v f = (f : X →ₗ[R] M) v := (rfl)

/-- Evaluation carries the piece of degree `q` into `ℳ q`. -/
theorem gradedHomEval_mem {v : X} {q : Γ} {f : gradedHom ℒ ℳ X}
    (hf : f ∈ gradedHomPiece ℒ ℳ X q) : gradedHomEval ℒ ℳ X v f ∈ ℳ q := hf v

/-- The bracket with a homogeneous element shifts the degree of a homogeneous map. -/
instance : SetLike.GradedBracket ℒ (gradedHomPiece ℒ ℳ X) where
  bracket_mem i j x f hx hf := fun v => by
    simpa only [LieSubmodule.coe_bracket, lie_linearMap_apply, vadd_eq_add] using
      SetLike.GradedBracket.bracket_mem hx (hf v)

variable [DirectSum.Decomposition ℳ]

/-- The pieces `gradedHomPiece` are independent: a map in two pieces of different degree
vanishes at every vector, since its value lies in two independent pieces of `ℳ`. -/
theorem iSupIndep_gradedHomPiece : iSupIndep (gradedHomPiece ℒ ℳ X) := by
  refine fun q => Submodule.disjoint_def.mpr fun f hq hrest => ?_
  refine Subtype.ext (LinearMap.ext fun v => ?_)
  have hv : gradedHomEval ℒ ℳ X v f ∈ ⨆ j ≠ q, ℳ j := by
    refine (iSup₂_le (fun j hj => ?_) : (⨆ j ≠ q, gradedHomPiece ℒ ℳ X j) ≤
      (⨆ j ≠ q, ℳ j).comap (gradedHomEval ℒ ℳ X v).toLinearMap) hrest
    exact fun g hg => Submodule.mem_iSup_of_mem j (Submodule.mem_iSup_of_mem hj (hg v))
  exact (Submodule.disjoint_def.mp
    ((DirectSum.Decomposition.isInternal ℳ).submodule_iSupIndep q) _ (hq v) hv)

omit [DirectSum.Decomposition ℳ] in
/-- Every map of `gradedHom` is a finite sum of homogeneous maps. -/
theorem iSup_gradedHomPiece : ⨆ q, gradedHomPiece ℒ ℳ X q = ⊤ := by
  rw [eq_top_iff]
  rintro ⟨f, hf⟩ -
  refine Submodule.iSup_induction' (motive := fun f hf => (⟨f, hf⟩ : gradedHom ℒ ℳ X) ∈
    ⨆ q, gradedHomPiece ℒ ℳ X q) (homPiece ℳ X)
    (fun q g hg => Submodule.mem_iSup_of_mem q hg) (Submodule.zero_mem _)
    (fun f g _ _ h₁ h₂ => Submodule.add_mem _ h₁ h₂) hf

/-- The maps of `gradedHom` are the internal direct sum of the pieces `gradedHomPiece`. -/
noncomputable instance : DirectSum.Decomposition (gradedHomPiece ℒ ℳ X) :=
  (DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    (iSupIndep_gradedHomPiece ℒ ℳ X) (iSup_gradedHomPiece ℒ ℳ X)).chooseDecomposition

/-- A map lies in `gradedHom` exactly when its values have homogeneous components in only
finitely many degrees in total. -/
theorem mem_gradedHom_iff_exists_finset {f : X →ₗ[R] M} :
    f ∈ gradedHom ℒ ℳ X ↔
      ∃ s : Finset Γ, ∀ v q, q ∉ s → (DirectSum.decompose ℳ (f v) q : M) = 0 := by
  classical
  constructor
  · intro hf
    refine Submodule.iSup_induction (homPiece ℳ X) (motive := fun f => ∃ s : Finset Γ,
      ∀ v q, q ∉ s → (DirectSum.decompose ℳ (f v) q : M) = 0) hf (fun q g hg => ?_)
      ⟨∅, fun v q _ => by simp⟩ ?_
    · exact ⟨{q}, fun v q' hq' => DirectSum.decompose_of_mem_ne ℳ (hg v)
        (Ne.symm (Finset.notMem_singleton.mp hq'))⟩
    · rintro f g ⟨s, hs⟩ ⟨t, ht⟩
      refine ⟨s ∪ t, fun v q hq => ?_⟩
      rw [Finset.mem_union, not_or] at hq
      simp [DirectSum.decompose_add, hs v q hq.1, ht v q hq.2]
  · rintro ⟨s, hs⟩
    -- Each value is the sum of its components in the degrees of `s`.
    have hv (v : X) : f v = ∑ q ∈ s, (DirectSum.decompose ℳ (f v) q : M) := by
      conv_lhs => rw [← DirectSum.sum_support_decompose ℳ (f v)]
      refine Finset.sum_subset (fun q hq => ?_) fun q _ hq => ?_
      · by_contra hqs
        exact DFinsupp.mem_support_iff.mp hq (Subtype.ext (hs v q hqs))
      · simp [DFinsupp.notMem_support_iff.mp hq]
    let proj (q : Γ) : X →ₗ[R] M := (ℳ q).subtype ∘ₗ
      DirectSum.component R Γ (fun i => ℳ i) q ∘ₗ
        (DirectSum.decomposeLinearEquiv ℳ).toLinearMap ∘ₗ f
    have hsum : f = ∑ q ∈ s, proj q := LinearMap.ext fun v => by
      rw [LinearMap.sum_apply, hv v]
      exact Finset.sum_congr rfl fun q _ => (rfl)
    rw [hsum]
    exact Submodule.sum_mem _ fun q _ =>
      homPiece_le_gradedHom ℒ ℳ q fun v => (DirectSum.decompose ℳ (f v) q).property

/-- The homogeneous components of a map are computed valuewise:
evaluating the degree-`q` component at `v` is the degree-`q` component of the value at `v`. -/
theorem decompose_gradedHomPiece_apply (v : X) (f : gradedHom ℒ ℳ X) (q : Γ) :
    ((DirectSum.decompose (gradedHomPiece ℒ ℳ X) f q : gradedHom ℒ ℳ X) : X →ₗ[R] M) v =
      DirectSum.decompose ℳ ((f : X →ₗ[R] M) v) q :=
  DirectSum.map_decompose_shift (gradedHomPiece ℒ ℳ X) ℳ
    (gradedHomEval ℒ ℳ X v).toAddMonoidHom id Function.injective_id
    (fun _ _ hx => gradedHomEval_mem ℒ ℳ X hx) q f

/-- A map has vanishing degree-`q` component exactly when all its values do. -/
theorem decompose_gradedHomPiece_eq_zero_iff (f : gradedHom ℒ ℳ X) (q : Γ) :
    (DirectSum.decompose (gradedHomPiece ℒ ℳ X) f q : gradedHom ℒ ℳ X) = 0 ↔
      ∀ v, (DirectSum.decompose ℳ ((f : X →ₗ[R] M) v) q : M) = 0 := by
  refine ⟨fun h v => ?_, fun h => Subtype.ext (LinearMap.ext fun v => ?_)⟩
  · rw [← decompose_gradedHomPiece_apply ℒ ℳ X v f q, h]
    rfl
  · rw [decompose_gradedHomPiece_apply]
    exact h v

end Graded

end Mei
