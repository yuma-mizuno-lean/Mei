module

public import Mathlib.LinearAlgebra.SesquilinearForm.Basic
public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.Algebra.Order.Ring.Defs

/-!
# Alternating forms on two generators

On combinations of two vectors `x, y`, an alternating bilinear form is the determinant of the
coefficients times `β x y` (`LinearMap.IsAlt.apply_zsmul_add_zsmul`). For a form valued in an
ordered ring, the relation `0 ≤ β u v` is therefore an angular order on the additive monoid
generated by `x` and `y`. It is transitive on nonzero vectors of that monoid
(`LinearMap.IsAlt.nonneg_trans_of_mem_closure_pair`): for coefficient vectors `u, v, w ∈ ℕ²`,
the Plücker relation `det(v, w) u - det(u, w) v + det(u, v) w = 0` expresses `det(u, w)` times
a positive coordinate of `v` as a nonnegative combination. The form may be degenerate, in
which case every value vanishes.

In rank two, this order sorts products of wall-crossing factors whose adjacent factors are
ordered, as in Nakanishi, *Cluster algebras and scattering diagrams, Part III*, §5.2,
arXiv:2111.00800v6.
-/

public section

namespace LinearMap.IsAlt

variable {Γ R : Type*} [AddCommGroup Γ] [CommRing R] {β : Γ →ₗ[ℤ] Γ →ₗ[ℤ] R}

/-- An alternating form on two combinations of `x` and `y` is the determinant of their
coefficients times `β x y`. -/
theorem apply_zsmul_add_zsmul (hβ : β.IsAlt) (x y : Γ) (a b a' b' : ℤ) :
    β (a • x + b • y) (a' • x + b' • y) = (a * b' - b * a') • β x y := by
  have hyx : β y x = -β x y := (hβ.neg x y).symm
  simp only [map_add, map_zsmul, LinearMap.add_apply, LinearMap.smul_apply, hβ.self_eq_zero,
    hyx, smul_zero, zero_add, add_zero, smul_neg, smul_smul, sub_smul]
  rw [mul_comm b a', sub_eq_neg_add, mul_comm b' a]

/-- **Transitivity of the angular order.** On nonzero vectors of the additive monoid generated
by `x` and `y`, the relation `0 ≤ β u v` of an alternating form valued in an ordered ring is
transitive. -/
theorem nonneg_trans_of_mem_closure_pair [LinearOrder R] [IsStrictOrderedRing R]
    (hβ : β.IsAlt) {x y u v w : Γ} (hu : u ∈ AddSubmonoid.closure {x, y})
    (hv : v ∈ AddSubmonoid.closure {x, y}) (hw : w ∈ AddSubmonoid.closure {x, y})
    (hv0 : v ≠ 0) (huv : 0 ≤ β u v) (hvw : 0 ≤ β v w) : 0 ≤ β u w := by
  obtain ⟨a₁, b₁, rfl⟩ := (AddSubmonoid.mem_closure_pair x y u).mp hu
  obtain ⟨a₂, b₂, rfl⟩ := (AddSubmonoid.mem_closure_pair x y v).mp hv
  obtain ⟨a₃, b₃, rfl⟩ := (AddSubmonoid.mem_closure_pair x y w).mp hw
  have e (a b a' b' : ℕ) :
      β (a • x + b • y) (a' • x + b' • y) = ((a * b' - b * a' : ℤ) : R) * β x y := by
    simpa [natCast_zsmul, zsmul_eq_mul] using apply_zsmul_add_zsmul hβ x y a b a' b'
  rw [e] at huv hvw ⊢
  -- The Plücker relation of the coefficient vectors, in each coordinate.
  have h₁ : ((a₁ * b₃ - b₁ * a₃ : ℤ) * β x y) * a₂ =
      ((a₂ * b₃ - b₂ * a₃ : ℤ) * β x y) * a₁ + ((a₁ * b₂ - b₁ * a₂ : ℤ) * β x y) * a₃ := by
    push_cast
    ring
  have h₂ : ((a₁ * b₃ - b₁ * a₃ : ℤ) * β x y) * b₂ =
      ((a₂ * b₃ - b₂ * a₃ : ℤ) * β x y) * b₁ + ((a₁ * b₂ - b₁ * a₂ : ℤ) * β x y) * b₃ := by
    push_cast
    ring
  have hnonneg (c : ℕ) (hc : 0 < c) (h : 0 ≤ ((a₁ * b₃ - b₁ * a₃ : ℤ) * β x y) * c) :
      0 ≤ ((a₁ * b₃ - b₁ * a₃ : ℤ) : R) * β x y :=
    (mul_nonneg_iff_of_pos_right (by exact_mod_cast hc)).mp h
  rcases Nat.eq_zero_or_pos a₂ with ha₂ | ha₂
  · rcases Nat.eq_zero_or_pos b₂ with hb₂ | hb₂
    · simp [ha₂, hb₂] at hv0
    · refine hnonneg b₂ hb₂ ?_
      rw [h₂]
      exact add_nonneg (mul_nonneg hvw (Nat.cast_nonneg _)) (mul_nonneg huv (Nat.cast_nonneg _))
  · refine hnonneg a₂ ha₂ ?_
    rw [h₁]
    exact add_nonneg (mul_nonneg hvw (Nat.cast_nonneg _)) (mul_nonneg huv (Nat.cast_nonneg _))

end LinearMap.IsAlt
